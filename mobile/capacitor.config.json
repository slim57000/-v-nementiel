{
  "appId": "com.mafeliza.app",
  "appName": "MaFeliza",
  "webDir": "www",
  "server": {
    "url": "https://mafeliza.com",
    "cleartext": false,
    "allowNavigation": ["mafeliza.com", "www.mafeliza.com", "*.livekit.cloud", "*.supabase.co"]
  },
  "ios": { "contentInset": "never", "backgroundColor": "#faf7f8" },
  "android": { "backgroundColor": "#faf7f8" },
  "plugins": {
    "SplashScreen": { "launchShowDuration": 1200, "backgroundColor": "#ffffff", "showSpinner": false },
    "StatusBar": { "style": "LIGHT", "backgroundColor": "#ffffff" }
  }
}
